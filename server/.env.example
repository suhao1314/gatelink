# 复制为 .env 后修改；生产环境建议直接用系统环境变量
# 注意：Node 22 不会自动加载 .env，请用 pm2 / systemd / docker 注入

PORT=8787
NODE_ENV=production

# 对外域名：二维码内容与分享链接都基于它，必须是已备案的 HTTPS 域名
PUBLIC_HOST=https://gate.example.com

# 小程序凭证：留空则服务端进入 DEV 模式（返回临时账号，仅用于本地联调）
WX_APPID=
WX_SECRET=

# 安全：这两项生产环境必须改成随机长字符串，改动后所有已登录用户需重新登录
TOKEN_SECRET=change-this-to-a-long-random-string
VISITOR_SALT=change-this-to-another-random-string

# 目录
DATA_DIR=./data
UPLOAD_DIR=./data/uploads
QR_DIR=./data/qr
DB_FILE=./data/gatelink.db

# 大小限制（字节）
MAX_UPLOAD_BYTES=5242880
MAX_IMAGE_BYTES=3145728

# 允许的前端域名，多个用逗号分隔，或填 *
ALLOWED_ORIGINS=*
