.pad { padding: 32rpx; }
.sk-line { height: 40rpx; margin-bottom: 24rpx; }
.sk-box { height: 160rpx; border-radius: 24rpx; }

.hero {
  margin-top: 16rpx;
  display: flex;
  align-items: center;
  padding: 40rpx 32rpx;
}

.avatar {
  width: 104rpx;
  height: 104rpx;
  border-radius: 52rpx;
  background: #F0F0F3;
  margin-right: 28rpx;
  flex-shrink: 0;
}

.hero-body { flex: 1; }

.hero-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #1D1D1F;
}

.hero-sub {
  color: #8E8E93;
  margin-top: 8rpx;
}

.row-row {
  display: flex;
  align-items: center;
  min-height: 104rpx;
  padding: 0 32rpx;
  background: #FFFFFF;
}

.row-row-col {
  flex-direction: column;
  align-items: stretch;
  padding: 28rpx 32rpx;
}

.row-row-label {
  font-size: 30rpx;
  color: #1D1D1F;
  margin-bottom: 12rpx;
}

.about-text { line-height: 1.7; }

.tip-text {
  font-size: 24rpx;
  color: #8E8E93;
  line-height: 1.6;
  padding: 0 32rpx 28rpx;
}
