.pad { padding: 32rpx; }

.sk-line { height: 40rpx; margin-bottom: 24rpx; }
.sk-big { height: 200rpx; margin-bottom: 24rpx; border-radius: 24rpx; }

.pick-wrap { padding: 24rpx 32rpx 8rpx; }

.pick {
  display: flex;
  align-items: center;
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 24rpx 28rpx;
}

.pick:active { opacity: 0.6; }

.pick-name {
  flex: 1;
  font-size: 32rpx;
  font-weight: 600;
  color: #1D1D1F;
}

.pick-arrow {
  width: 32rpx;
  height: 32rpx;
  opacity: 0.5;
}

.seg-wrap { padding: 16rpx 32rpx 8rpx; }

.seg {
  display: flex;
  background: #F0F0F3;
  border-radius: 14rpx;
  padding: 4rpx;
}

.seg-item {
  flex: 1;
  height: 64rpx;
  line-height: 64rpx;
  text-align: center;
  font-size: 27rpx;
  color: #6E6E73;
  border-radius: 10rpx;
}

.seg-on { background: #FFFFFF; color: #1D1D1F; font-weight: 600; }

.stat-grid {
  display: flex;
  gap: 20rpx;
  padding: 16rpx 32rpx;
}

.stat-card {
  flex: 1;
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 32rpx 24rpx;
}

.stat-num {
  font-size: 54rpx;
  font-weight: 600;
  line-height: 1.15;
  color: #1D1D1F;
}

.stat-lab {
  font-size: 24rpx;
  color: #6E6E73;
  margin-top: 8rpx;
}

.card {
  background: #FFFFFF;
  border-radius: 24rpx;
  margin: 16rpx 32rpx;
  padding: 32rpx;
}

.card-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1D1D1F;
  margin-bottom: 28rpx;
}

.delta-row {
  display: flex;
  align-items: baseline;
  gap: 16rpx;
}

.delta-num { font-size: 44rpx; font-weight: 600; }
.delta-hint { font-size: 24rpx; color: #6E6E73; flex: 1; }
.delta-pct { font-size: 26rpx; }
.delta-pct.up { color: #2D6A0B; }
.delta-pct.down { color: #B3261E; }

.chart {
  display: flex;
  align-items: flex-end;
  height: 200rpx;
  gap: 8rpx;
}

.chart-col {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  height: 100%;
  justify-content: flex-end;
}

.chart-bar-wrap {
  width: 100%;
  flex: 1;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

.chart-bar {
  width: 60%;
  background: #007AFF;
  border-radius: 6rpx 6rpx 0 0;
}

.chart-lab {
  font-size: 20rpx;
  color: #8E8E93;
  margin-top: 10rpx;
  transform: scale(0.92);
}

.chart-sum { margin-top: 16rpx; text-align: center; }

.hours {
  display: flex;
  align-items: flex-end;
  height: 140rpx;
  gap: 4rpx;
}

.hour-col {
  flex: 1;
  height: 100%;
  display: flex;
  align-items: flex-end;
}

.hour-bar {
  width: 100%;
  background: #B5D4F4;
  border-radius: 4rpx 4rpx 0 0;
}

.hour-legend {
  display: flex;
  justify-content: space-between;
  margin-top: 12rpx;
}

.bar-row { margin-bottom: 28rpx; }
.bar-row:last-child { margin-bottom: 0; }

.bar-row-top {
  display: flex;
  justify-content: space-between;
  align-items: baseline;
  margin-bottom: 12rpx;
}

.bar-name {
  font-size: 28rpx;
  color: #1D1D1F;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.bar-val { flex-shrink: 0; }

.bar-track {
  height: 12rpx;
  background: #F0F0F3;
  border-radius: 6rpx;
  overflow: hidden;
}

.bar-fill {
  height: 100%;
  background: #007AFF;
  border-radius: 6rpx;
}

.bar-fill-2 { background: #34C759; }

.os-row { display: flex; gap: 40rpx; }

.os-item { display: flex; flex-direction: column; gap: 4rpx; }

.os-name { font-size: 28rpx; color: #1D1D1F; }

.share-desc {
  margin-bottom: 28rpx;
  line-height: 1.6;
}

.share-url {
  background: #F5F5F7;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  color: #3A3A3C;
  word-break: break-all;
  margin-bottom: 24rpx;
  line-height: 1.6;
}

.revoke-text {
  text-align: center;
  color: #FF3B30;
  font-size: 28rpx;
  padding: 28rpx 0 4rpx;
}

.note {
  padding: 32rpx 48rpx 0;
  line-height: 1.6;
  color: #8E8E93;
}

.empty-btn {
  background: #007AFF;
  color: #FFFFFF;
  border-radius: 16rpx;
  font-size: 32rpx;
  padding: 0 48rpx;
  height: 96rpx;
  line-height: 96rpx;
}
