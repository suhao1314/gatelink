{
  "description": "GateLink 活码台项目配置",
  "packOptions": {
    "ignore": [
      { "type": "file", "value": ".eslintrc.js" },
      { "type": "folder", "value": "node_modules" }
    ],
    "include": []
  },
  "setting": {
    "urlCheck": false,
    "es6": true,
    "enhance": true,
    "postcss": true,
    "minified": true,
    "minifyWXSS": true,
    "minifyWXML": true,
    "coverView": true,
    "lazyloadPlaceholderEnable": false,
    "checkInvalidKey": true,
    "checkSiteMap": true,
    "uploadWithSourceMap": true,
    "babelSetting": { "ignore": [], "disablePlugins": [], "outputPath": "" }
  },
  "compileType": "miniprogram",
  "libVersion": "3.5.5",
  "appid": "touristappid",
  "projectname": "gatelink",
  "simulatorType": "wechat",
  "condition": {}
}
